@startuml secuencia_diseno
title CU 28 - Vista dinámica de diseño: registro de la recepción con patrón State\n(pasos 10 a 12 del flujo; se muestra la opción "contenido igual al registrado")
autonumber
skinparam sequenceMessageAlign left

actor "EB" as EB
boundary ":PantallaRegRecBolsin" as P
control ":GestorRegRecepBolsin" as G
entity ":Estado" as E
entity "seleccionado:Bolsin" as B
entity "actualCEB:CambioEstadoBolsin" as CEB
entity "nuevoCEB:CambioEstadoBolsin" as NCEB
entity ":Remito" as R
entity ":DetalleRemito" as DR
entity ":Documentacion" as D
entity "enviado:EnBolsinEnviado" as EBE
entity "actualCED:CambioEstadoDocumentacion" as CED
entity "aceptada:RecibidaYAceptada" as RYA
entity "nuevoCED:CambioEstadoDocumentacion" as NCED
boundary ":InterfazNotificacion" as IN

EB -> P : tomarConfirmacion()
P -> G : tomarConfirmacion(true)
G -> G : obtenerFechaHoraActual()
G -> G : buscarEstadoRecibidoEnCMDestino()
loop mientras haya estados
  G -> E : esAmbitoBolsin()
  G -> E : esRecibidoEnCMDestino()
end
G -> G : buscarEstadoRecibidoYAceptadoRemito()
loop mientras haya estados
  G -> E : esAmbitoRemito()
  G -> E : esRecibidoYAceptado()
end
G -> G : buscarEstadoRecibidoYAceptadoParcialRemito()
note right of G : mismo recorrido con
esRecibidoYAceptadoParcial()

G -> G : setBolsinEstadoRecibido()
G -> B : recibirBolsin(estadoRecibido, situaciones, areas, fechaHora, empleado, estAceptado, estParcial)
B -> B : obtenerCambioEstadoActual()
loop por cada CambioEstadoBolsin
  B -> CEB : sosActual()
end
B -> CEB : setFechaHoraFin(fechaHora)
B -> B : setBolsinEstadoRecibido(estadoRecibido, fechaHora, empleado)
B -> B : crearCambioEstadoBolsin(estadoRecibido, fechaHora, empleado)
B -> NCEB ** : new(estadoRecibido, fechaHora, empleado)

loop por cada remito del bolsín
  B -> R : recibirYAceptar(situaciones, areas, fechaHora, empleado, estAceptado, estParcial)
  R -> R : setEstadoRecibidaYAceptada(situaciones, estAceptado, estParcial)
  loop por cada DetalleRemito
    R -> DR : getDocumentacion()
    R -> DR : actualizarEstadoDoc(ACEPTADA, null, fechaHora, empleado)
    DR -> D : aceptar(fechaHora, empleado)
    D -> EBE : aceptar(self, fechaHora, empleado)
    EBE -> EBE : cambiarEstado(doc, RecibidaYAceptada, fechaHora, empleado)
    EBE -> EBE : buscarCambioEstadoActual(doc)
    EBE -> D : getCambiosEstado()
    loop por cada CambioEstadoDocumentacion
      EBE -> CED : sosActual()
    end
    EBE -> CED : setFechaHoraFin(fechaHora)
    EBE -> EBE : crearSigEstado(RecibidaYAceptada)
    EBE -> RYA ** : new()
    EBE -> EBE : crearCambioEstado(aceptada, fechaHora, empleado)
    EBE -> NCED ** : new(aceptada, fechaHora, empleado)
    EBE -> D : agregarCambioEstado(nuevoCED)
    EBE -> D : setEstadoActual(aceptada)
  end
end

G -> G : notificarRecepcion()
note right of G : se incluye CU 29\nNotificar recepción de bolsín
loop por cada CM de origen
  G -> IN : enviarNotificacion(email, asunto, cuerpo)
end
G -> G : obtenerResultado()
P -> P : mostrarResultado()
G -> G : finCU()
@enduml
